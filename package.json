{
  "name": "promptforage",
  "version": "1.0.0",
  "description": "Automate image generation from PDF prompts using Google Flow and Playwright",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck:extension": "tsc -p extension/tsconfig.json --noEmit",
    "build:extension": "npm run typecheck:extension && node scripts/build-extension.mjs",
    "test": "tsx --test src/promptParser.test.ts"
  },
  "keywords": [
    "typescript",
    "playwright",
    "pdf",
    "image-generation",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
